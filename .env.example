# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Auth cookie domain (optional)
# Explicit host domain for Supabase auth cookies. Set this when staging and
# production run on sibling subdomains (e.g. staging.example.com and
# app.example.com) so each environment scopes its cookies to its own host and
# they can never overlap and corrupt each other. Leave unset for host-only
# cookies (the safe default for a single deployment).
# NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=app.example.com

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
ENABLE_REAL_SMS=false

# SMS Integration (text.lk - Sri Lankan SMS Provider)
# Get API key from: https://www.text.lk/dashboard
TEXT_LK_API_KEY=your-text-lk-api-key
TEXT_LK_SENDER_ID=YourGymName
TEXT_LK_WEBHOOK_SECRET=your-webhook-secret

# Cron Jobs (generate with: openssl rand -base64 32)
CRON_SECRET=your-cron-secret-key

# Admin Dashboard (SaaS operator system-health monitoring)
# The system-health dashboard and its /api/admin/* routes are restricted to the
# single operator account whose login email matches this value. Server-side only
# (never prefix with NEXT_PUBLIC_ — that would ship it to every browser).
# Leave unset to disable the admin dashboard entirely (fail closed).
ADMIN_ALLOWED_EMAIL=operator@example.com

# Demo Tools (in-person sales demos)
# Email of the single gym account allowed to use the /api/demo/* endpoints and
# see the in-app Demo SMS panel. Server-side only (never prefix with NEXT_PUBLIC_).
# Leave unset to fully disable all demo tooling (fail closed).
DEMO_TOOLS_ALLOWED_EMAIL=owner@example.com
