# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database direct connection (server-only, for local backups / migrations CLI)
# Supabase Dashboard -> Project Settings -> Database -> Connection string (URI, direct)
# Example: postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Auth cookie domain (optional)
# Explicit host domain for Supabase auth cookies. Set this when staging and
# production run on sibling subdomains (e.g. staging.example.com and
# app.example.com) so each environment scopes its cookies to its own host and
# they can never overlap and corrupt each other. Leave unset for host-only
# cookies (the safe default for a single deployment).
# NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=app.example.com

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
ENABLE_REAL_SMS=false

# SMS Integration (text.lk - Sri Lankan SMS Provider)
# Get API key from: https://www.text.lk/dashboard
TEXT_LK_API_KEY=your-text-lk-api-key
TEXT_LK_SENDER_ID=YourGymName
TEXT_LK_WEBHOOK_SECRET=your-webhook-secret

# Cron Jobs (generate with: openssl rand -base64 32)
CRON_SECRET=your-cron-secret-key

# Admin Dashboard (SaaS operator system-health surfaces)
# No secret: access is gated by a Supabase session + membership in the
# saas_admins table. Provision an operator by inserting their auth.users id
# (service role / dashboard SQL) — see docs/DEPLOYMENT_PAYHERE_CHECKLIST.md.
# The retired NEXT_PUBLIC_ADMIN_API_SECRET was compiled into the browser
# bundle and must NOT be reintroduced.

# PayHere (SaaS Lite/Pro/Enterprise subscription billing — all tiers paid)
# Merchant credentials: PayHere dashboard > Integrations. The Merchant Secret
# is per-domain (approval up to 24h) and MUST stay server-side only.
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=your-payhere-merchant-id
PAYHERE_MERCHANT_SECRET=your-payhere-merchant-secret
PAYHERE_LITE_PRICE_LKR=2990
# PAYHERE_PRO_PRICE_LKR history: 4900 (pro-original) -> 2990 (growth) ->
# 4990 (pro-new). Name stable, meaning changed — deploy the 4990 flip together
# with migration 20260708000003 (see docs/DEPLOYMENT_PAYHERE_CHECKLIST.md).
PAYHERE_PRO_PRICE_LKR=4990
PAYHERE_ENTERPRISE_PRICE_LKR=6990
# OAuth REST (Subscription Manager: cancel/retry/list). Create an API key in
# the PayHere dashboard; domain-whitelisted. LIVE REST additionally requires
# server IP whitelisting via support@payhere.lk.
PAYHERE_APP_ID=your-payhere-app-id
PAYHERE_APP_SECRET=your-payhere-app-secret

# Cloudflare R2 (member face photos — S3-compatible object storage)
# Create an R2 bucket and an API token with Object Read & Write permissions.
# Uploads use presigned PUT URLs generated server-side; these credentials are
# server-only (never prefix with NEXT_PUBLIC_).
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
# Public base URL of the bucket for rendering photos (custom domain
# recommended; r2.dev works for development). Safe to expose to the browser.
NEXT_PUBLIC_R2_PUBLIC_URL=https://media.example.com

# Demo Tools (in-person sales demos)
# Email of the single gym account allowed to use the /api/demo/* endpoints and
# see the in-app Demo SMS panel. Server-side only (never prefix with NEXT_PUBLIC_).
# Leave unset to fully disable all demo tooling (fail closed).
DEMO_TOOLS_ALLOWED_EMAIL=owner@example.com
