# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
ENABLE_REAL_SMS=false

# SMS Integration (text.lk - Sri Lankan SMS Provider)
# Get API key from: https://www.text.lk/dashboard
TEXT_LK_API_KEY=your-text-lk-api-key
TEXT_LK_SENDER_ID=YourGymName
TEXT_LK_WEBHOOK_SECRET=your-webhook-secret

# Cron Jobs (generate with: openssl rand -base64 32)
CRON_SECRET=your-cron-secret-key

# Admin Dashboard (SaaS operator system-health surfaces)
# No secret: access is gated by a Supabase session + membership in the
# saas_admins table. Provision an operator by inserting their auth.users id
# (service role / dashboard SQL) — see docs/DEPLOYMENT_PAYHERE_CHECKLIST.md.
# The retired NEXT_PUBLIC_ADMIN_API_SECRET was compiled into the browser
# bundle and must NOT be reintroduced.

# PayHere (SaaS Free/Pro subscription billing)
# Merchant credentials: PayHere dashboard > Integrations. The Merchant Secret
# is per-domain (approval up to 24h) and MUST stay server-side only.
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=your-payhere-merchant-id
PAYHERE_MERCHANT_SECRET=your-payhere-merchant-secret
PAYHERE_PRO_PRICE_LKR=4900
# OAuth REST (Subscription Manager: cancel/retry/list). Create an API key in
# the PayHere dashboard; domain-whitelisted. LIVE REST additionally requires
# server IP whitelisting via support@payhere.lk.
PAYHERE_APP_ID=your-payhere-app-id
PAYHERE_APP_SECRET=your-payhere-app-secret
