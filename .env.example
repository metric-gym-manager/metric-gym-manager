# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
ENABLE_REAL_SMS=false

# SMS Integration (text.lk - Sri Lankan SMS Provider)
# Get API key from: https://www.text.lk/dashboard
TEXT_LK_API_KEY=your-text-lk-api-key
TEXT_LK_SENDER_ID=YourGymName
TEXT_LK_WEBHOOK_SECRET=your-webhook-secret

# Cron Jobs (generate with: openssl rand -base64 32)
CRON_SECRET=your-cron-secret-key

# Admin Dashboard (generate with: openssl rand -base64 32)
# Used for SaaS admin-only routes and system health monitoring
ADMIN_API_SECRET=your-admin-api-secret
NEXT_PUBLIC_ADMIN_API_SECRET=your-admin-api-secret
