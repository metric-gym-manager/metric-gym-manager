# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database connection (server-only, for `npm run db:audit` and local backups)
# Supabase Dashboard -> Project Settings -> Database -> Connection string
#
# Use the SESSION POOLER, not the direct URI. The direct endpoint
# (db.[ref].supabase.co) is IPv6-only and is unreachable from WSL and from CI
# runners without IPv6; the pooler resolves over IPv4. Copy the host from the
# dashboard rather than guessing the prefix — it is aws-0 or aws-1 per project.
SUPABASE_DB_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-1-[region].pooler.supabase.com:5432/postgres

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Auth cookie domain (optional)
# Explicit host domain for Supabase auth cookies. Set this when staging and
# production run on sibling subdomains (e.g. staging.example.com and
# app.example.com) so each environment scopes its cookies to its own host and
# they can never overlap and corrupt each other. Leave unset for host-only
# cookies (the safe default for a single deployment).
# NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=app.example.com

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
ENABLE_REAL_SMS=false

# SMS Integration (text.lk - Sri Lankan SMS Provider)
# Get API key from: https://www.text.lk/dashboard
TEXT_LK_API_KEY=your-text-lk-api-key
TEXT_LK_SENDER_ID=YourGymName
TEXT_LK_WEBHOOK_SECRET=your-webhook-secret
# Gyms that must never be texted: gym ids, comma-separated. Used for the E2E
# test gyms, which live in the production database with valid-format seeded
# numbers. Enforced in sendSmsViaTextLk (every real text); the reminders cron
# skips them up front. Set in Vercel by the operator, never by a gym. Empty = text every gym.
SMS_DISABLED_GYM_IDS=

# Cron Jobs (generate with: openssl rand -base64 32)
CRON_SECRET=your-cron-secret-key

# Admin Dashboard (SaaS operator system-health surfaces)
# No secret: access is gated by a Supabase session + membership in the
# saas_admins table. Provision an operator by inserting their auth.users id
# (service role / dashboard SQL) — see docs/setup/DEPLOYMENT_PAYHERE_CHECKLIST.md.
# The retired NEXT_PUBLIC_ADMIN_API_SECRET was compiled into the browser
# bundle and must NOT be reintroduced.

# PayHere (SaaS Lite/Pro/Enterprise subscription billing — all tiers paid)
# Merchant credentials: PayHere dashboard > Integrations. The Merchant Secret
# is per-domain (approval up to 24h) and MUST stay server-side only.
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=your-payhere-merchant-id
PAYHERE_MERCHANT_SECRET=your-payhere-merchant-secret
PAYHERE_LITE_PRICE_LKR=2990
# PAYHERE_PRO_PRICE_LKR history: 4900 (pro-original) -> 2990 (growth) ->
# 4990 (pro-new). Name stable, meaning changed — deploy the 4990 flip together
# with migration 20260708000003 (see docs/setup/DEPLOYMENT_PAYHERE_CHECKLIST.md).
PAYHERE_PRO_PRICE_LKR=4990
PAYHERE_ENTERPRISE_PRICE_LKR=6990
# OAuth REST (Subscription Manager: cancel/retry/list). Create an API key in
# the PayHere dashboard; domain-whitelisted. LIVE REST additionally requires
# server IP whitelisting via support@payhere.lk.
PAYHERE_APP_ID=your-payhere-app-id
PAYHERE_APP_SECRET=your-payhere-app-secret

# Cloudflare R2 (member face photos — S3-compatible object storage)
# Create an R2 bucket and an API token with Object Read & Write permissions.
# Uploads use presigned PUT URLs generated server-side; these credentials are
# server-only (never prefix with NEXT_PUBLIC_).
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
# Public base URL of the bucket for rendering photos (custom domain
# recommended; r2.dev works for development). Safe to expose to the browser.
NEXT_PUBLIC_R2_PUBLIC_URL=https://media.example.com

# Access Control Hardware (VFT / ZKTeco biometric readers — Enterprise tier)
# Off unless explicitly enabled: with this unset the Mock provider is used and
# no request ever reaches real door hardware, which is what lets the feature
# ship and run in CI before it has been exercised against a terminal.
ACCESS_CONTROL_ENABLED=false
# Fallback vendor base URL. Each gym stores its own, so this is only for
# single-deployment setups.
VFT_API_BASE_URL=https://vft.example.com
# AES-256-GCM key for encrypting per-gym vendor credentials at rest.
# MUST decode to exactly 32 bytes: openssl rand -base64 32
# Rotating this makes every stored credential unreadable — re-enter them.
ACCESS_CONTROL_ENCRYPTION_KEY=your-base64-32-byte-key
# The unguessable token in the inbound webhook path:
#   POST /api/webhooks/access-control/<token>
# The push protocol defines no header signature, so this is the ONLY credential
# on that endpoint. Generate with: openssl rand -hex 32
# Leave unset to refuse all inbound device events (fail closed).
#
# The value below is a PLACEHOLDER and is REJECTED AT RUNTIME. Copying this
# file without replacing this line gives an endpoint that would otherwise
# authenticate against a value committed to this repository, and it would look
# identical from outside to a correct deployment. The guard lives in
# `describeWebhookTokenProblem` (lib/access-control/config.ts) and refuses
# anything containing placeholder text or shorter than 32 characters.
ACCESS_CONTROL_WEBHOOK_TOKEN=your-hex-64-webhook-token
# Optional second factor, when a deployment can arrange one.
# ACCESS_CONTROL_WEBHOOK_SECRET=

# Demo Tools (in-person sales demos)
# Email of the single gym account allowed to use the /api/demo/* endpoints and
# see the in-app Demo SMS panel. Server-side only (never prefix with NEXT_PUBLIC_).
# Leave unset to fully disable all demo tooling (fail closed).
DEMO_TOOLS_ALLOWED_EMAIL=owner@example.com

# Email (demo-request notifications)
# Each demo request from the public site is emailed to hello@metricgymos.com,
# sent through Gmail as the Google Workspace account below, from the verified
# "Send mail as" alias noreply@metricgymos.com. SMTP_USER must be the account
# itself (an alias cannot log in: Gmail answers 535). SMTP_PASS is a Google app
# password for that account (Security → 2-Step Verification → App passwords).
# Server-side only. Leave either unset to send nothing: requests are still
# stored, with leads.notification_error saying why no email went out.
SMTP_USER=admin@capitalistone.co
SMTP_PASS=your-16-character-app-password

# Email (marketing and product updates, through Resend)
# Contacts, topics and the /unsubscribe page (docs/architecture/marketing-email.md).
# RESEND_API_KEY must be a FULL-ACCESS key: the contacts and topics endpoints
# answer 401 restricted_api_key to a sending-only one.
# MARKETING_UNSUBSCRIBE_SECRET signs unsubscribe links (HMAC of the contact's
# email; generate with `openssl rand -hex 32`). It must be the SAME value
# everywhere (Vercel, and any machine that runs the sync): changing it breaks
# every link already sent until the contacts are re-signed with
# `scripts/sync-marketing-contacts.ts --apply --rotate-tokens`.
# Server-side only. Leave either unset to disable: /unsubscribe then asks people
# to write to hello@, and consenting leads are stored but not added to Resend.
RESEND_API_KEY=re_your_full_access_key
MARKETING_UNSUBSCRIBE_SECRET=your-64-hex-character-secret
