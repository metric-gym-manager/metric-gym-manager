{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "disableAllHooks": true,
  "permissions": {
    "allow": [
      "Bash(npx tsx scripts/hw-session.ts *)",
      "Bash(npx jest *)",
      "Bash(git fetch origin master)",
      "Read",
      "Grep",
      "Glob"
    ],
    "deny": [
      "Read(./.env.local)",
      "Read(./.env)",
      "Read(./backups/hw-session/dev-server.log)",
      "Bash(cat .env*)",
      "Bash(npx tsx scripts/provision-access-control-test-gym.ts *)",
      "Bash(ALLOW_CREDENTIAL_OVERWRITE=*)",
      "Edit",
      "Write",
      "NotebookEdit"
    ]
  }
}
