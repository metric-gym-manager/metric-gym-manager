{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "master": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/update-expired-status",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/expire-suspended-members",
      "schedule": "15 0 * * *"
    },
    {
      "path": "/api/cron/cancel-overdue-members",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/charge-renewals",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/process-dunning",
      "schedule": "45 0 * * *"
    },
    {
      "path": "/api/cron/process-trial-expiry",
      "schedule": "50 0 * * *"
    },
    {
      "path": "/api/cron/send-reminders",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/reconcile-access",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/cron/drain-access-sync",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/purge-access-events",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/sync-marketing-contacts",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/send-announcements",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/send-outreach",
      "schedule": "30 4 * * 2"
    }
  ]
}
